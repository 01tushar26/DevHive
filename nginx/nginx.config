server {
    listen 80;
    server_name devhive.tushardev.me;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name devhive.tushardev.me;
    ssl_certificate /etc/letsencrypt/live/devhive.tushardev.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devhive.tushardev.me/privkey.pem;
    location / {
        proxy_pass http://frontend:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 80;
    server_name api.devhive.tushardev.me;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name api.devhive.tushardev.me;
    client_max_body_size 20M;
    ssl_certificate /etc/letsencrypt/live/devhive.tushardev.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/devhive.tushardev.me/privkey.pem;
    location / {
        proxy_pass http://backend:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}

